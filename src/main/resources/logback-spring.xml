<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <include resource="org/springframework/boot/logging/logback/defaults.xml" />

    <!-- 修改一下路径-->
    <!--<property name="MODULE_NAME" value="account-server"/>-->
    <property name="MODULE_ROOT" value="${user.dir}"/>
    <property name="PATH" value="${MODULE_ROOT}/logs"/>

    <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>
                %d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %clr(%-5level) %-30logger{30}:%method:%-4line [%magenta(%-16X{LOG_ID})] : %clr(%msg) %n
            </pattern>
        </encoder>
    </appender>

    <appender name="TRACE_FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${PATH}/trace.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <FileNamePattern>${PATH}/trace.%d{yyyy-MM-dd}.%i.log.gz</FileNamePattern>
            <maxFileSize>10MB</maxFileSize>
            <maxHistory>30</maxHistory>           <!-- 最多保留30天 -->
            <totalSizeCap>2GB</totalSizeCap>      <!-- 归档总大小上限 -->
            <cleanHistoryOnStart>true</cleanHistoryOnStart> <!-- 启动时清理过期归档 -->
        </rollingPolicy>
        <encoder>
            <charset>UTF-8</charset>
            <pattern>
                %d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %-5level %-30logger{30}:%method:%-4line [%-16X{LOG_ID}] : %msg %n
            </pattern>
        </encoder>
    </appender>

    <appender name="ERROR_FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${PATH}/error.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <FileNamePattern>${PATH}/error.%d{yyyy-MM-dd}.%i.log.gz</FileNamePattern>
            <maxFileSize>10MB</maxFileSize>
            <maxHistory>90</maxHistory>           <!-- ERROR 保留更久 -->
            <totalSizeCap>1GB</totalSizeCap>
            <cleanHistoryOnStart>true</cleanHistoryOnStart>
        </rollingPolicy>
        <layout>
            <charset>UTF-8</charset>
            <pattern>
                %d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %-5level %-30logger{30}:%method:%-4line [%-16X{LOG_ID}] : %msg %n
            </pattern>
        </layout>
        <filter class="ch.qos.logback.classic.filter.LevelFilter">
            <level>ERROR</level>
            <onMatch>ACCEPT</onMatch>
            <onMismatch>DENY</onMismatch>
        </filter>
    </appender>

    <!-- 新增：切面日志专属 DEBUG 级别配置 -->
    <logger name="com.chipswu.aggregatedsearchplatform.aop.LogAspect" level="DEBUG" additivity="true"/>
    <logger name="com.chipswu.aggregatedsearchplatform.config.MyBatisFlexConfig" level="DEBUG" additivity="true"/>

    <root level="INFO">
        <appender-ref ref="STDOUT"/>
        <appender-ref ref="TRACE_FILE"/>
        <appender-ref ref="ERROR_FILE"/>
    </root>
</configuration>